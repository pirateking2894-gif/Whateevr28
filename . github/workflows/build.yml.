name: Build FakeLocation.dylib

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Compile
        run: |
          xcrun -sdk iphoneos clang -arch arm64 -dynamiclib -fobjc-arc \
            -miphoneos-version-min=14.0 \
            -framework Foundation -framework CoreLocation \
            -o FakeLocation.dylib FakeLocation.m
          codesign -f -s - FakeLocation.dylib
      - uses: actions/upload-artifact@v4
        with:
          name: FakeLocation
          path: FakeLocation.dylib
